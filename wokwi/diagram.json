{
  "version": 1,
  "author": "ThermoGuard IoT",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": 0,
      "left": 180,
      "attrs": {
        "temperature": "24",
        "humidity": "50"
      }
    }
  ],
  "connections": [
    ["esp:3V3", "dht:VCC", "red", []],
